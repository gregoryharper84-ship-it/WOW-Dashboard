{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gregoryharper84-ship-it/WOW-Dashboard/blob/main/docs/wow/governance/V17_PREGAME_ATTESTATION_V1.schema.json",
  "title": "WOW V17 frozen prediction receipt inside an in-toto v1 Statement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "digest"
        ],
        "properties": {
          "name": {
            "const": "frozen-prediction.json"
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://github.com/gregoryharper84-ship-it/WOW-Dashboard/blob/main/docs/wow/governance/V17_PREGAME_ATTESTATION_V1.md"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozenPrediction"
      ],
      "properties": {
        "frozenPrediction": {
          "$ref": "#/$defs/receipt"
        }
      }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "probability": {
      "oneOf": [
        {
          "$ref": "#/$defs/decimal"
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "prediction_id",
        "sport",
        "official_event_id",
        "home_team",
        "away_team",
        "event_start_time_utc",
        "market_type",
        "settlement_basis",
        "selected_side",
        "signed_home_line",
        "quote_source_id",
        "quote_observed_at_utc",
        "frozen_at_utc",
        "model_artifact_sha256",
        "feature_snapshot_sha256",
        "quote_receipt_sha256",
        "p_cover",
        "p_push",
        "p_not_cover",
        "calibrated_lower_bound",
        "calibrated_upper_bound",
        "model_certification_status",
        "certification_reference_id",
        "terminal_authority",
        "probability_publishable",
        "can_execute"
      ],
      "properties": {
        "contract": {
          "const": "WOW_V17_PREGAME_RECEIPT_V1"
        },
        "prediction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sport": {
          "enum": [
            "NFL",
            "NBA",
            "WNBA",
            "NCAAF",
            "NCAAB",
            "NHL",
            "MLB",
            "SOCCER",
            "TENNIS"
          ]
        },
        "official_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "home_team": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "away_team": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "event_start_time_utc": {
          "$ref": "#/$defs/time"
        },
        "market_type": {
          "enum": [
            "POINT_SPREAD",
            "PUCK_LINE",
            "RUN_LINE",
            "ASIAN_HANDICAP",
            "GAME_HANDICAP",
            "SET_HANDICAP"
          ]
        },
        "settlement_basis": {
          "enum": [
            "FULL_GAME_INCLUDING_OVERTIME",
            "FULL_GAME_INCLUDING_OVERTIME_SHOOTOUT",
            "FULL_GAME_INCLUDING_EXTRA_INNINGS",
            "REGULATION",
            "COMPLETED_MATCH_NO_RETIREMENT"
          ]
        },
        "selected_side": {
          "enum": [
            "HOME",
            "AWAY"
          ]
        },
        "signed_home_line": {
          "$ref": "#/$defs/decimal"
        },
        "quote_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "quote_observed_at_utc": {
          "$ref": "#/$defs/time"
        },
        "frozen_at_utc": {
          "$ref": "#/$defs/time"
        },
        "model_artifact_sha256": {
          "$ref": "#/$defs/digest"
        },
        "feature_snapshot_sha256": {
          "$ref": "#/$defs/digest"
        },
        "quote_receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "p_cover": {
          "$ref": "#/$defs/probability"
        },
        "p_push": {
          "$ref": "#/$defs/probability"
        },
        "p_not_cover": {
          "$ref": "#/$defs/probability"
        },
        "calibrated_lower_bound": {
          "$ref": "#/$defs/probability"
        },
        "calibrated_upper_bound": {
          "$ref": "#/$defs/probability"
        },
        "model_certification_status": {
          "enum": [
            "UNQUALIFIED",
            "CERTIFIED_FITTED"
          ]
        },
        "certification_reference_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal_authority": {
          "const": "V17_TERMINAL_REDUCER"
        },
        "probability_publishable": {
          "type": "boolean"
        },
        "can_execute": {
          "const": false
        }
      }
    }
  }
}
