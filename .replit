modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 4200

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8001
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 25643
externalPort = 3002

[[ports]]
localPort = 25644
externalPort = 3003

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NWS_USER_AGENT = "WOW-v16-Kalshi-Weather gregory.harper84@gmail.com"
KALSHI_API_BASE = "https://external-api.kalshi.com/trade-api/v2"
ENABLE_NOMADS_NBM = "false"
ENABLE_OPEN_METEO = "false"
REPLIT_APP_URL = "https://create-app-gregoryharper84.replit.app"
