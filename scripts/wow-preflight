#!/usr/bin/env bash
# wow-preflight — WOW Engineering Control Plane pre-patch safety checks
#
# Run before starting any WOW patch session.
# Exits non-zero if any check fails.
#
# Usage: bash scripts/wow-preflight

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FLASK_DIR="$REPO_ROOT/artifacts/flask-scoring-api"
PASS=0
FAIL=0
WARN=0

green()  { printf '\033[0;32m✓ %s\033[0m\n' "$*"; }
red()    { printf '\033[0;31m✗ %s\033[0m\n' "$*"; }
yellow() { printf '\033[0;33m⚠ %s\033[0m\n' "$*"; }

section() { printf '\n\033[1m=== %s ===\033[0m\n' "$*"; }

# ---------------------------------------------------------------------------
section "Working tree"
# ---------------------------------------------------------------------------
# Detect both tracked modifications (staged + unstaged) and untracked files.
# git diff --name-only HEAD covers staged and unstaged changes to tracked files.
# git ls-files --others --exclude-standard covers new, untracked files.

DIRTY=$(git -C "$REPO_ROOT" diff --name-only HEAD 2>/dev/null || true)
UNTRACKED=$(git -C "$REPO_ROOT" ls-files --others --exclude-standard 2>/dev/null || true)

if [ -z "$DIRTY" ] && [ -z "$UNTRACKED" ]; then
    green "Working tree is clean"
    (( ++PASS ))
else
    red "Uncommitted changes detected — checkpoint before proceeding:"
    [ -n "$DIRTY" ]     && echo "$DIRTY"     | sed 's/^/    M /'
    [ -n "$UNTRACKED" ] && echo "$UNTRACKED" | sed 's/^/    ? /'
    (( ++FAIL ))
fi

# ---------------------------------------------------------------------------
section "Protected-file baseline"
# ---------------------------------------------------------------------------

PROTECTED_FILES=(
    "artifacts/flask-scoring-api/gate_engine/labels.py"
    "artifacts/flask-scoring-api/gate_engine/llp_governance.py"
    "artifacts/flask-scoring-api/gate_engine/data_contract.py"
    "artifacts/flask-scoring-api/gate_engine/failure_path.py"
)

for f in "${PROTECTED_FILES[@]}"; do
    if [ -f "$REPO_ROOT/$f" ]; then
        green "Protected file exists: $f"
        ((++PASS))
    else
        red "Protected file MISSING: $f"
        ((++FAIL))
    fi
done

# ---------------------------------------------------------------------------
section "Secret scan"
# ---------------------------------------------------------------------------

SECRET_PATTERNS=(
    "api_key[[:space:]]*=[[:space:]]*[\"'][^\"']{8,}"
    "password[[:space:]]*=[[:space:]]*[\"'][^\"']{4,}"
    'sk-[a-zA-Z0-9]{20,}'
    'Bearer [a-zA-Z0-9_.-]{20,}'
)

# Paths excluded from secret scanning — third-party and build artifacts only.
# Test files remain in scope so real secrets cannot be hidden in test code.
SECRET_EXCLUDE_ARGS=(
    --exclude-dir=.pythonlibs
    --exclude-dir=.cache
    --exclude-dir=node_modules
    --exclude-dir=dist
    --exclude-dir=".git"
)

# For high-specificity patterns (sk-/Bearer) that appear in test fixtures
# (specifically test_control_plane_scripts.py, which places fake sk- keys in
# temp files to prove the scanner catches them), additionally exclude test
# infrastructure files.  Real secrets must never be placed in test files;
# test-file scanning is enforced by wow-verify-patch on the diff boundary.
TEST_INFRA_EXCLUDE_ARGS=(
    --exclude-dir=tests
    --exclude="test_*.py"
)

# Narrow synthetic-fixture allowlist for the broad api_key and password
# patterns. These files use clearly-labelled _TEST_API_KEY / _TEST_KEY
# constants as test fixtures.  New test files are NOT excluded — they will
# be scanned.  Exclusions must be documented here with their fixture purpose.
#
#   test_governance_api.py              _TEST_API_KEY = "test-key-governance"
#   test_kalshi_wx_terminal_label_*.py  _TEST_API_KEY = "test-scoring-key-failclosed-patch"
#   test_kalshi_wx_active_status_*.py   _TEST_API_KEY = "test-key-wx-active-status-norm"
#   test_control_plane_scripts.py       intentional fake keys (scanner test vectors)
BROAD_PATTERN_FIXTURE_EXCLUDE_ARGS=(
    --exclude="test_governance_api.py"
    --exclude="test_kalshi_wx_terminal_label_failclosed.py"
    --exclude="test_kalshi_wx_active_status_normalization.py"
    --exclude="test_control_plane_scripts.py"
)

SECRET_FOUND=0
for pattern in "${SECRET_PATTERNS[@]}"; do
    # Choose the right exclusion level for this pattern:
    #   sk-/Bearer  — broad test-dir exclusion (these look like real keys;
    #                 test_control_plane_scripts.py writes them to temp files
    #                 to prove detection works)
    #   api_key/password — narrow per-file exclusion for 4 known synthetic
    #                 fixture files only; all other test files remain scanned
    if [[ "$pattern" == sk-* ]] || [[ "$pattern" == Bearer* ]]; then
        EXTRA=("${TEST_INFRA_EXCLUDE_ARGS[@]}")
    else
        EXTRA=("${BROAD_PATTERN_FIXTURE_EXCLUDE_ARGS[@]}")
    fi

    HITS=$(grep -rI --include="*.py" --include="*.md" --include="*.yaml" \
               "${SECRET_EXCLUDE_ARGS[@]}" "${EXTRA[@]}" \
               -l -i -E "$pattern" "$REPO_ROOT" 2>/dev/null || true)
    if [ -n "$HITS" ]; then
        red "Possible secret pattern ($pattern) in:"
        echo "$HITS" | sed 's/^/    /'
        SECRET_FOUND=1
    fi
done

if [ "$SECRET_FOUND" -eq 0 ]; then
    green "No hardcoded secrets detected"
    ((++PASS))
else
    ((++FAIL))
fi

# ---------------------------------------------------------------------------
section "can_execute=false enforcement"
# ---------------------------------------------------------------------------
# Check Python source files for any non-commented can_execute=True assignment.
# Also check YAML/JSON files for can_execute: true directives (case-insensitive).
# Both forms represent a live-execution violation.

EXEC_FAIL=0

# Python: actual assignment forms only — anchored to line start (after optional
# whitespace) so string literals and docstring lines like
#   "...engine returned can_execute=True"
#   - Does NOT set can_execute=True.
# are not matched.  -P enables Perl regex for \s support.
EXEC_TRUE_PY=$(grep -rn --include="*.py" -P '^\s*can_execute\s*=\s*True' \
               "$FLASK_DIR/gate_engine/" 2>/dev/null \
               | grep -v "test_" || true)
if [ -n "$EXEC_TRUE_PY" ]; then
    red "can_execute=True found in production gate_engine Python code:"
    echo "$EXEC_TRUE_PY" | sed 's/^/    /'
    EXEC_FAIL=1
fi

# YAML/JSON/TOML: colon-style directives (e.g. can_execute: true, can_execute: True)
EXEC_TRUE_CFG=$(grep -rn --include="*.yaml" --include="*.yml" --include="*.json" \
                -iE 'can_execute[[:space:]]*:[[:space:]]*true' "$FLASK_DIR/gate_engine/" 2>/dev/null \
                | grep -v "test_\|#" || true)
if [ -n "$EXEC_TRUE_CFG" ]; then
    red "can_execute: true found in production gate_engine YAML/JSON:"
    echo "$EXEC_TRUE_CFG" | sed 's/^/    /'
    EXEC_FAIL=1
fi

if [ "$EXEC_FAIL" -eq 0 ]; then
    green "can_execute=True not found in gate_engine (non-test)"
    ((++PASS))
else
    ((++FAIL))
fi

# ---------------------------------------------------------------------------
section "Fast smoke test (isolation sentinel only)"
# ---------------------------------------------------------------------------

if command -v python3 &>/dev/null; then
    cd "$FLASK_DIR"
    RESULT=$(python3 -m pytest gate_engine/tests/test_stage_a_isolation.py -q --tb=no 2>&1 | tail -3)
    # We expect the sentinel to fail if there are uncommitted changes;
    # if tree is clean, all isolation tests should pass.
    FAILURES=$(echo "$RESULT" | grep -oE '[0-9]+ failed' | grep -oE '[0-9]+' || echo "0")
    PASSED=$(echo "$RESULT" | grep -oE '[0-9]+ passed' | grep -oE '[0-9]+' || echo "0")
    if [ "$FAILURES" -eq 0 ]; then
        green "Isolation tests: $PASSED passed, 0 failed"
        ((++PASS))
    elif [ "$FAILURES" -eq 1 ]; then
        yellow "Isolation tests: $PASSED passed, 1 failed (runtime sentinel — expected on clean tree before commit)"
        ((++WARN))
    else
        red "Isolation tests: $FAILURES failures — investigate before starting patch"
        echo "$RESULT" | sed 's/^/    /'
        ((++FAIL))
    fi
    cd "$REPO_ROOT"
else
    yellow "python3 not found — skipping smoke test"
    ((++WARN))
fi

# ---------------------------------------------------------------------------
section "Summary"
# ---------------------------------------------------------------------------

printf '\n'
printf 'Passed: %d\n' "$PASS"
printf 'Warned: %d\n' "$WARN"
printf 'Failed: %d\n' "$FAIL"

if [ "$FAIL" -gt 0 ]; then
    red "Preflight FAILED — resolve all failures before starting patch work."
    exit 1
elif [ "$WARN" -gt 0 ]; then
    yellow "Preflight passed with warnings — review before proceeding."
    exit 0
else
    green "Preflight PASSED — safe to begin patch."
    exit 0
fi
