# WOW Data Hub — MCP Server environment variables
# Copy to .env and fill in real values. Never commit .env.

# Flask scoring API (legacy Data Hub server)
SCORING_API_URL=http://localhost:25643
SCORING_API_KEY=your_scoring_api_key_here

# Express API server (legacy Data Hub props adapter)
API_SERVER_URL=http://localhost:8080/api

# Provider API keys (legacy/optional)
ODDS_API_KEY=your_odds_api_key_here
OPTICODDS_API_KEY=your_opticodds_key_here
PROPLINE_API_KEY=your_propline_key_here
SPORTSGAMEODDS_API_KEY=your_sportsgameodds_key_here

# -----------------------------------------------------------------------------
# WOW V17 Actions -> MCP migration gateway
# -----------------------------------------------------------------------------
# Existing governed backend. Probability computation remains there.
WOW_V17_BACKEND_URL=https://wow-governed-probability-engine.onrender.com

# SERVER-SIDE ONLY. Use the backend's existing secret value at deploy time.
# Never put a real value in this file, source control, a Skill, prompt, or log.
WOW_ACTION_API_KEY=server-side-secret-only

# Auth modes:
#   shared-token = isolated acceptance only
#   oauth        = production candidate; validates signed access tokens + V17 permissions
#   disabled     = CI/local protocol tests only; never internet-facing
WOW_MCP_AUTH_MODE=shared-token
WOW_MCP_SHARED_TOKEN=acceptance-only-secret

# OAuth resource-server configuration. Required when WOW_MCP_AUTH_MODE=oauth.
# Supabase OAuth scopes are standard identity scopes; V17 operation authorization is
# enforced separately from the signed `wow_mcp_permissions` custom access-token claim.
WOW_MCP_PUBLIC_URL=https://wow-v17-mcp.example.com
WOW_MCP_OAUTH_ISSUER=https://your-project.supabase.co/auth/v1
WOW_MCP_OAUTH_RESOURCE=https://wow-v17-mcp.example.com/mcp
WOW_MCP_OAUTH_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
WOW_MCP_OAUTH_SCOPES=openid email
WOW_MCP_OAUTH_ALLOWED_SUBJECTS=approved-supabase-user-uuid
WOW_MCP_OAUTH_PERMISSION_CLAIM=wow_mcp_permissions
WOW_MCP_OAUTH_JWKS_TTL_MS=300000
WOW_MCP_OAUTH_FETCH_TIMEOUT_MS=10000

# Optional adapter limits.
WOW_MCP_UPSTREAM_TIMEOUT_MS=330000
WOW_MCP_MAX_BODY_BYTES=2097152
