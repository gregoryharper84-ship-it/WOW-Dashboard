# WOW Data Hub — MCP Server environment variables
# Copy to .env and fill in real values. Never commit .env.

# Flask scoring API (legacy Data Hub server)
SCORING_API_URL=http://localhost:25643
SCORING_API_KEY=your_scoring_api_key_here

# Express API server (legacy Data Hub props adapter)
API_SERVER_URL=http://localhost:8080/api

# Provider API keys (legacy/optional)
ODDS_API_KEY=your_odds_api_key_here
OPTICODDS_API_KEY=your_opticodds_key_here
PROPLINE_API_KEY=your_propline_key_here
SPORTSGAMEODDS_API_KEY=your_sportsgameodds_key_here

# -----------------------------------------------------------------------------
# WOW V17 Actions -> MCP migration gateway
# -----------------------------------------------------------------------------
# Existing governed backend. Probability computation remains there.
WOW_V17_BACKEND_URL=https://wow-governed-probability-engine.onrender.com

# SERVER-SIDE ONLY. Use the backend's existing secret value at deploy time.
# Never put a real value in this file, source control, a Skill, prompt, or log.
WOW_ACTION_API_KEY=server-side-secret-only

# Acceptance scaffold. Keep this on the isolated acceptance service only.
WOW_MCP_AUTH_MODE=shared-token
WOW_MCP_SHARED_TOKEN=acceptance-only-secret

# Production protected-resource mode. OAuth secrets are NOT stored here.
# Supabase Auth example issuer: https://<project-ref>.supabase.co/auth/v1
# The gateway validates asymmetric JWTs through the issuer JWKS and fails closed
# unless the OAuth client_id is explicitly allowlisted.
# WOW_MCP_AUTH_MODE=oauth
# WOW_MCP_OAUTH_ISSUER=https://project-ref.supabase.co/auth/v1
# WOW_MCP_OAUTH_AUDIENCE=authenticated
# WOW_MCP_OAUTH_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
# WOW_MCP_OAUTH_AUTHORIZATION_SERVERS=https://project-ref.supabase.co/auth/v1
# WOW_MCP_OAUTH_ALLOWED_CLIENT_IDS=registered-chatgpt-oauth-client-id
# WOW_MCP_OAUTH_RESOURCE_URL=https://wow-v17-mcp.example.com/mcp
# Supabase OAuth currently supports standard OIDC scopes only. WOW operation
# permissions therefore come from this signed server-controlled claim; native
# scope/scp claims are also honored if a future/provider implementation issues them.
# WOW_MCP_OAUTH_PERMISSION_CLAIM=app_metadata.wow_permissions
# WOW_MCP_OAUTH_SCOPES_SUPPORTED=openid,email,profile

# Optional adapter limits.
WOW_MCP_UPSTREAM_TIMEOUT_MS=330000
WOW_MCP_MAX_BODY_BYTES=2097152
