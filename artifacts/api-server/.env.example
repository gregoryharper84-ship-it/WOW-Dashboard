# Server-only configuration. Supply secrets through the runtime secret manager.
PORT=8080
BASE_PATH=/final-lock/
WOW_V17_BACKEND_URL=https://wow-governed-probability-engine.onrender.com
WOW_V17_BACKEND_API_KEY=replace-with-server-held-v17-action-key
WOW_DASHBOARD_API_KEY=replace-with-distinct-dashboard-access-key

# Optional legacy V16 compatibility services. These do not store V17 receipts.
# SCORING_API_URL=http://127.0.0.1:25643
# SCORING_API_KEY=replace-with-legacy-flask-api-key
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/legacy_dashboard

# Development fixture servers only; production should use HTTPS.
# WOW_V17_ALLOW_LOCAL_BACKEND=true
